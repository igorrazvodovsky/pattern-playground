{
  "root": "transitions",
  "elements": {
    "transitions": {
      "type": "Stack",
      "props": { "gap": "m" },
      "children": ["sentence", "detail", "full"]
    },
    "sentence": {
      "type": "Text",
      "props": { "text": "The refurbishment log flags the" },
      "children": ["mention", "sentence-rest"]
    },
    "mention": {
      "type": "Reference",
      "props": {
        "label": { "$state": "/product/name" },
        "icon": "product",
        "focusKey": "mention",
        "preview": { "$bindState": "/preview" },
        "expanded": {
          "$cond": { "$or": [{ "$state": "/detailOpen" }, { "$state": "/fullOpen" }] },
          "$then": true,
          "$else": false
        }
      },
      "children": ["summary"],
      "slots": { "suffix": ["summary-to-detail", "summary-to-full"] },
      "on": {
        "open": [
          {
            "action": "setState",
            "params": {
              "statePath": "/detailOpen",
              "value": {
                "$cond": { "$state": "/preferred", "eq": "mid" },
                "$then": true,
                "$else": false
              }
            }
          },
          {
            "action": "setState",
            "params": {
              "statePath": "/fullOpen",
              "value": {
                "$cond": { "$state": "/preferred", "eq": "maxi" },
                "$then": true,
                "$else": false
              }
            }
          }
        ]
      }
    },
    "summary": {
      "type": "ItemView",
      "props": { "type": "product", "item": { "$state": "/product" }, "scope": "mini" }
    },
    "summary-to-detail": {
      "type": "Button",
      "props": { "label": "Detail", "icon": "detail", "hideLabel": true, "variant": "plain" },
      "on": {
        "press": [
          { "action": "setState", "params": { "statePath": "/preview", "value": false } },
          { "action": "setState", "params": { "statePath": "/preferred", "value": "mid" } },
          { "action": "setState", "params": { "statePath": "/detailOpen", "value": true } }
        ]
      }
    },
    "summary-to-full": {
      "type": "Button",
      "props": { "label": "Full", "icon": "full", "hideLabel": true, "variant": "plain" },
      "on": {
        "press": [
          { "action": "setState", "params": { "statePath": "/preview", "value": false } },
          { "action": "setState", "params": { "statePath": "/preferred", "value": "maxi" } },
          { "action": "setState", "params": { "statePath": "/fullOpen", "value": true } }
        ]
      }
    },
    "sentence-rest": {
      "type": "Text",
      "props": {
        "text": " for a battery-module swap before the autumn fleet handover.",
        "inline": true
      }
    },

    "detail": {
      "type": "Drawer",
      "props": {
        "title": { "$state": "/product/name" },
        "open": { "$bindState": "/detailOpen" },
        "returnFocus": "mention"
      },
      "slots": { "suffix": ["detail-to-summary", "detail-to-full"] },
      "children": ["detail-body"]
    },
    "detail-to-summary": {
      "type": "Button",
      "props": { "label": "Summary", "icon": "summary", "hideLabel": true, "variant": "plain" },
      "on": {
        "press": [
          { "action": "setState", "params": { "statePath": "/detailOpen", "value": false } },
          { "action": "setState", "params": { "statePath": "/preview", "value": true } }
        ]
      }
    },
    "detail-to-full": {
      "type": "Button",
      "props": { "label": "Full", "icon": "full", "hideLabel": true, "variant": "plain" },
      "on": {
        "press": [
          { "action": "setState", "params": { "statePath": "/detailOpen", "value": false } },
          { "action": "setState", "params": { "statePath": "/preferred", "value": "maxi" } },
          { "action": "setState", "params": { "statePath": "/fullOpen", "value": true } }
        ]
      }
    },
    "detail-body": {
      "type": "ItemView",
      "props": { "type": "product", "item": { "$state": "/product" }, "scope": "mid" }
    },

    "full": {
      "type": "Dialog",
      "props": {
        "title": { "$state": "/product/name" },
        "open": { "$bindState": "/fullOpen" },
        "returnFocus": "mention"
      },
      "slots": { "suffix": ["full-to-summary", "full-to-detail"] },
      "children": ["full-body"]
    },
    "full-to-summary": {
      "type": "Button",
      "props": { "label": "Summary", "icon": "summary", "hideLabel": true, "variant": "plain" },
      "on": {
        "press": [
          { "action": "setState", "params": { "statePath": "/fullOpen", "value": false } },
          { "action": "setState", "params": { "statePath": "/preview", "value": true } }
        ]
      }
    },
    "full-to-detail": {
      "type": "Button",
      "props": { "label": "Detail", "icon": "detail", "hideLabel": true, "variant": "plain" },
      "on": {
        "press": [
          { "action": "setState", "params": { "statePath": "/fullOpen", "value": false } },
          { "action": "setState", "params": { "statePath": "/preferred", "value": "mid" } },
          { "action": "setState", "params": { "statePath": "/detailOpen", "value": true } }
        ]
      }
    },
    "full-body": {
      "type": "ItemView",
      "props": { "type": "product", "item": { "$state": "/product" }, "scope": "maxi" }
    }
  }
}
