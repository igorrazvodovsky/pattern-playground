{
  "root": "products",
  "elements": {
    "products": {
      "type": "Table",
      "props": {
        "label": "Products",
        "columns": [
          { "label": "Product", "align": null },
          { "label": "Category", "align": null },
          { "label": "Condition", "align": null },
          { "label": "Price", "align": "end" },
          { "label": "Status", "align": null }
        ]
      },
      "repeat": { "statePath": "/products", "key": "id" },
      "children": ["product"]
    },
    "product": {
      "type": "TableRow",
      "props": {},
      "children": ["name", "category", "condition", "price", "status"]
    },
    "name": { "type": "TableCell", "props": { "text": { "$item": "name" } } },
    "category": { "type": "TableCell", "props": { "text": { "$item": "category" } } },
    "condition": { "type": "TableCell", "props": { "text": { "$item": "condition" } } },
    "price": { "type": "TableCell", "props": { "text": { "$item": "price" }, "align": "end" } },
    "status": { "type": "TableCell", "props": { "text": null }, "children": ["status-badge"] },
    "status-badge": { "type": "Badge", "props": { "text": { "$item": "status" } }, "visible": { "$item": "status" } }
  }
}
