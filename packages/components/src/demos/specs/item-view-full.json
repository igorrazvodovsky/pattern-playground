{
  "root": "full-view",
  "elements": {
    "full-view": {
      "type": "Card",
      "props": { "title": { "$state": "/product/name" } },
      "children": ["full-view-body"]
    },
    "full-view-body": {
      "type": "ItemView",
      "props": { "type": "product", "item": { "$state": "/product" }, "scope": "maxi" }
    }
  }
}
