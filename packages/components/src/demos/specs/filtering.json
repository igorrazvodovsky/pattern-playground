{
  "root": "filtering",
  "elements": {
    "filtering": {
      "type": "Stack",
      "props": { "gap": "m" },
      "children": ["filter-bar", "tasks", "toasts", "task-drawer"],
      "watch": {
        "/filters": {
          "action": "setState",
          "params": {
            "statePath": "/derived",
            "value": { "$computed": "derive", "args": { "filters": { "$state": "/filters" } } }
          }
        },
        "/filterQuery": [
          {
            "action": "interpret",
            "params": {
              "statePath": "/interpretation",
              "prompt": {
                "$computed": "unmatched",
                "args": {
                  "query": { "$state": "/filterQuery" },
                  "scope": { "$state": "/filterScope" }
                }
              }
            }
          },
          {
            "action": "setState",
            "params": {
              "statePath": "/field",
              "value": {
                "$computed": "field",
                "args": {
                  "query": { "$state": "/filterQuery" },
                  "scope": { "$state": "/filterScope" },
                  "interpretation": { "$state": "/interpretation" }
                }
              }
            }
          }
        ],
        "/filterScope": {
          "action": "setState",
          "params": {
            "statePath": "/field",
            "value": {
              "$computed": "field",
              "args": {
                "query": { "$state": "/filterQuery" },
                "scope": { "$state": "/filterScope" },
                "interpretation": { "$state": "/interpretation" }
              }
            }
          }
        },
        "/interpretation": {
          "action": "setState",
          "params": {
            "statePath": "/field",
            "value": {
              "$computed": "field",
              "args": {
                "query": { "$state": "/filterQuery" },
                "scope": { "$state": "/filterScope" },
                "interpretation": { "$state": "/interpretation" }
              }
            }
          }
        }
      }
    },

    "filter-bar": {
      "type": "Stack",
      "props": { "direction": "horizontal", "gap": "s" },
      "children": ["filters", "clear-filters", "filter-field"]
    },
    "filters": {
      "type": "Stack",
      "props": { "direction": "horizontal", "gap": "s" },
      "repeat": { "statePath": "/derived/clauses", "key": "id" },
      "children": ["filter"]
    },
    "filter": {
      "type": "FilterTag",
      "props": {
        "label": { "$item": "label" },
        "icon": { "$item": "icon" },
        "operator": { "$item": "operator" },
        "operators": { "$item": "operators" },
        "values": { "$item": "values" },
        "options": { "$item": "options" },
        "glyphs": { "$item": "glyphs" },
        "focusNext": "Clear filter",
        "edit": { "$bindState": "/filterEdit" }
      },
      "on": {
        "change": {
          "action": "setState",
          "params": {
            "statePath": "/filters",
            "value": {
              "$computed": "editFilter",
              "args": {
                "filters": { "$state": "/filters" },
                "id": { "$item": "id" },
                "edit": { "$state": "/filterEdit" }
              }
            }
          }
        },
        "remove": {
          "action": "setState",
          "params": {
            "statePath": "/filters",
            "value": {
              "$computed": "removeFilter",
              "args": { "filters": { "$state": "/filters" }, "id": { "$item": "id" } }
            }
          }
        }
      }
    },
    "clear-filters": {
      "type": "Button",
      "props": {
        "label": "Clear filters",
        "icon": "cancel",
        "hideLabel": true,
        "focusNext": "Add a filter"
      },
      "visible": { "$state": "/derived/filtered" },
      "on": {
        "press": { "action": "setState", "params": { "statePath": "/filters", "value": [] } }
      }
    },
    "filter-field": {
      "type": "Combobox",
      "props": {
        "label": "Add a filter",
        "hideLabel": true,
        "popup": true,
        "icon": "filter",
        "placeholder": { "$state": "/field/placeholder" },
        "value": { "$bindState": "/filterQuery" },
        "scope": { "$bindState": "/filterScope" },
        "groups": { "$state": "/field/groups" },
        "status": { "$state": "/field/status" }
      },
      "on": {
        "select": [
          {
            "action": "setState",
            "params": {
              "statePath": "/picked",
              "value": {
                "$computed": "pick",
                "args": {
                  "filters": { "$state": "/filters" },
                  "toasts": { "$state": "/toasts" },
                  "picked": { "$state": "/filterQuery" },
                  "interpretation": { "$state": "/interpretation" }
                }
              }
            }
          },
          {
            "action": "setState",
            "params": { "statePath": "/filters", "value": { "$state": "/picked/filters" } }
          },
          {
            "action": "setState",
            "params": { "statePath": "/toasts", "value": { "$state": "/picked/toasts" } }
          },
          { "action": "setState", "params": { "statePath": "/filterQuery", "value": "" } }
        ]
      }
    },
    "tasks": {
      "type": "ItemGroup",
      "props": { "label": "Tasks" },
      "repeat": { "statePath": "/derived/tasks", "key": "id" },
      "children": ["task"]
    },
    "task": {
      "type": "Item",
      "props": { "title": { "$item": "title" } },
      "slots": { "attributes": ["task-attributes"] }
    },
    "task-attributes": {
      "type": "Stack",
      "props": { "direction": "horizontal", "gap": "s" },
      "repeat": { "statePath": { "$item": "attributes" } },
      "children": ["task-attribute"]
    },
    "task-attribute": {
      "type": "Badge",
      "props": { "label": { "$item": "label" }, "text": { "$item": "value" } }
    },

    "toasts": {
      "type": "Toasts",
      "props": { "toasts": { "$bindState": "/toasts" }, "pressed": { "$bindState": "/pressed" } },
      "on": {
        "action": [
          {
            "action": "setState",
            "params": { "statePath": "/task", "value": { "$state": "/pressed/task" } }
          },
          { "action": "setState", "params": { "statePath": "/taskOpen", "value": true } }
        ]
      }
    },
    "task-drawer": {
      "type": "Drawer",
      "props": {
        "title": {
          "$cond": { "$state": "/task" },
          "$then": { "$state": "/task/title" },
          "$else": "Task"
        },
        "open": { "$bindState": "/taskOpen" }
      },
      "children": ["task-status", "task-specification", "task-history"]
    },
    "task-status": {
      "type": "Badge",
      "props": {
        "label": "Status",
        "text": {
          "$cond": { "$state": "/task" },
          "$then": { "$state": "/task/status" },
          "$else": ""
        }
      }
    },
    "task-specification": {
      "type": "Text",
      "props": {
        "text": {
          "$cond": { "$state": "/task" },
          "$then": { "$state": "/task/specification" },
          "$else": ""
        }
      }
    },
    "task-history": {
      "type": "Timeline",
      "props": { "density": "compact" },
      "repeat": { "statePath": "/task/history", "key": "id" },
      "children": ["task-event"]
    },
    "task-event": {
      "type": "TimelineEntry",
      "props": {
        "title": { "$item": "title" },
        "by": { "$item": "by" },
        "time": { "$item": "time" }
      }
    }
  }
}
