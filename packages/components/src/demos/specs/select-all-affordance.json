{
  "root": "select-all-demo",
  "elements": {
    "select-all-demo": {
      "type": "Stack",
      "props": { "gap": "m" },
      "children": ["selection-toolbar", "escalation", "projects"],
      "watch": {
        "/items": {
          "action": "setState",
          "params": {
            "statePath": "/selection",
            "value": { "$computed": "selection", "args": { "items": { "$state": "/items" } } }
          }
        }
      }
    },

    "selection-toolbar": {
      "type": "Stack",
      "props": { "direction": "horizontal", "gap": "s", "align": "center" },
      "children": ["summary", "clear", "select-visible"]
    },
    "summary": {
      "type": "Text",
      "props": {
        "text": {
          "$computed": "summary",
          "args": { "items": { "$state": "/items" }, "escalated": { "$state": "/selection/escalated" }, "matching": { "$state": "/matching" } }
        },
        "muted": true,
        "status": true
      }
    },
    "clear": {
      "type": "Button",
      "props": { "label": "Clear", "variant": "plain", "focusNext": "Select all visible" },
      "visible": { "$state": "/selection/any" },
      "on": {
        "press": {
          "action": "setState",
          "params": {
            "statePath": "/items",
            "value": { "$computed": "clearAll", "args": { "items": { "$state": "/items" } } }
          }
        }
      }
    },
    "select-visible": {
      "type": "Button",
      "props": { "label": "Select all visible", "variant": "plain", "focusNext": "Clear" },
      "visible": { "$state": "/selection/any", "not": true },
      "on": {
        "press": {
          "action": "setState",
          "params": {
            "statePath": "/items",
            "value": { "$computed": "selectAll", "args": { "items": { "$state": "/items" } } }
          }
        }
      }
    },

    "escalation": {
      "type": "Callout",
      "props": {
        "text": { "$concat": ["All ", { "$count": { "$state": "/items" } }, " items on this page are selected."] },
        "purpose": "info"
      },
      "visible": [{ "$state": "/selection/all" }, { "$state": "/selection/escalated", "not": true }],
      "slots": { "actions": ["escalate"] }
    },
    "escalate": {
      "type": "Button",
      "props": { "label": { "$concat": ["Select all ", { "$format": "number", "value": { "$state": "/matching" } }, " matching items"] }, "variant": "plain", "focusNext": "Clear" },
      "on": { "press": { "action": "setState", "params": { "statePath": "/selection/escalated", "value": true } } }
    },

    "projects": {
      "type": "List",
      "props": { "borderless": true },
      "repeat": { "statePath": "/items", "key": "id" },
      "children": ["project"]
    },
    "project": {
      "type": "ListItem",
      "props": {
        "label": { "$item": "name" },
        "icon": "project",
        "checkbox": true,
        "checked": { "$bindItem": "selected" }
      }
    }
  }
}
