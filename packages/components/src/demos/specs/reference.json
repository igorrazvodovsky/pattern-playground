{
  "root": "reference",
  "elements": {
    "reference": { "type": "Stack", "props": { "gap": "m" }, "children": ["note", "detail"] },
    "note": {
      "type": "MentionEditor",
      "props": {
        "label": "Meeting note",
        "placeholder": "Type @ to reference a person, project, document or product",
        "content": { "$bindState": "/content" },
        "query": { "$bindState": "/query" },
        "scope": { "$bindState": "/scope" },
        "candidates": {
          "$computed": "candidates",
          "args": {
            "query": { "$state": "/query" },
            "scope": { "$state": "/scope" },
            "sources": { "$state": "/sources" }
          }
        },
        "opened": { "$bindState": "/opened" }
      },
      "on": {
        "open": [
          {
            "action": "setState",
            "params": {
              "statePath": "/detail",
              "value": {
                "$computed": "view",
                "args": { "id": { "$state": "/opened" }, "views": { "$state": "/views" } }
              }
            }
          },
          { "action": "setState", "params": { "statePath": "/detailOpen", "value": true } }
        ]
      }
    },

    "detail": {
      "type": "Drawer",
      "props": { "title": { "$state": "/detail/name" }, "open": { "$bindState": "/detailOpen" } },
      "children": ["detail-body"]
    },
    "detail-body": {
      "type": "ItemView",
      "props": {
        "type": { "$state": "/detail/type" },
        "item": { "$state": "/detail/item" },
        "scope": "mid",
        "shownAttributes": { "$state": "/detail/shown" }
      }
    }
  }
}
