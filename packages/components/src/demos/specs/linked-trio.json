{
  "root": "linked-trio",
  "elements": {
    "linked-trio": {
      "type": "Panes",
      "props": { "room": { "$bindState": "/room" } },
      "children": ["map-above", "list", "hint", "map-beside", "pane"]
    },
    "map-above": {
      "type": "Map",
      "props": {
        "label": "Map",
        "locations": { "$state": "/locations" },
        "selected": { "$bindState": "/selected" },
        "focused": { "$bindState": "/focused" }
      },
      "visible": { "$state": "/room", "not": true }
    },
    "list": {
      "type": "ItemGroup",
      "props": { "label": "List" },
      "repeat": { "statePath": "/products", "key": "id" },
      "children": ["item"]
    },
    "item": {
      "type": "Item",
      "props": {
        "title": { "$item": "name" },
        "opens": true,
        "selected": {
          "$cond": { "$item": "id", "eq": { "$state": "/selected" } },
          "$then": true,
          "$else": false
        },
        "focused": {
          "$cond": { "$item": "id", "eq": { "$state": "/focused" } },
          "$then": true,
          "$else": false
        },
        "expanded": {
          "$cond": { "$state": "/room" },
          "$then": null,
          "$else": {
            "$cond": { "$item": "id", "eq": { "$state": "/selected" } },
            "$then": true,
            "$else": false
          }
        }
      },
      "slots": { "attributes": ["item-attributes"], "detail": ["in-place"] },
      "on": {
        "open": [
          {
            "action": "setState",
            "params": {
              "statePath": "/selected",
              "value": {
                "$cond": { "$item": "id", "eq": { "$state": "/selected" } },
                "$then": null,
                "$else": { "$item": "id" }
              }
            }
          }
        ],
        "focus": [
          {
            "action": "setState",
            "params": { "statePath": "/focused", "value": { "$value": { "$item": "id" } } }
          }
        ],
        "blur": [{ "action": "setState", "params": { "statePath": "/focused", "value": null } }]
      }
    },
    "item-attributes": {
      "type": "Stack",
      "props": { "direction": "horizontal", "gap": "s" },
      "repeat": { "statePath": { "$item": "attributes" } },
      "children": ["item-attribute"]
    },
    "item-attribute": {
      "type": "Badge",
      "props": { "label": { "$item": "label" }, "text": { "$item": "value" } }
    },
    "in-place": {
      "type": "ItemView",
      "props": {
        "type": "product",
        "item": { "$item": "product" },
        "scope": "mid",
        "shownAttributes": { "$state": "/inPlaceAttributes" }
      }
    },
    "hint": {
      "type": "Text",
      "props": { "text": "Pick an item in either view to see its detail.", "muted": true },
      "visible": {
        "$and": [
          { "$state": "/room", "not": true },
          { "$state": "/selected", "not": true }
        ]
      }
    },
    "map-beside": {
      "type": "Map",
      "props": {
        "label": "Map",
        "locations": { "$state": "/locations" },
        "selected": { "$bindState": "/selected" },
        "focused": { "$bindState": "/focused" }
      },
      "visible": { "$state": "/room" }
    },
    "pane": {
      "type": "Stack",
      "props": { "gap": "m", "label": "Detail" },
      "visible": { "$state": "/room" },
      "children": ["pane-hint", "pane-views"]
    },
    "pane-hint": {
      "type": "Text",
      "props": { "text": "Pick an item in either view to see its detail.", "muted": true },
      "visible": { "$state": "/selected", "not": true }
    },
    "pane-views": {
      "type": "Stack",
      "props": { "gap": "m" },
      "repeat": { "statePath": "/products", "key": "id" },
      "children": ["pane-view"]
    },
    "pane-view": {
      "type": "Card",
      "props": { "title": { "$item": "name" } },
      "visible": { "$item": "id", "eq": { "$state": "/selected" } },
      "children": ["detail-body"]
    },
    "detail-body": {
      "type": "ItemView",
      "props": { "type": "product", "item": { "$item": "product" }, "scope": "mid" }
    }
  }
}
