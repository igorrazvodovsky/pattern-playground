{
  "root": "listings-demo",
  "elements": {
    "listings-demo": {
      "type": "Stack",
      "props": { "gap": "m" },
      "children": ["listings", "empty-state"]
    },

    "listings": {
      "type": "List",
      "props": { "borderless": true },
      "repeat": { "statePath": "/items", "key": "id" },
      "children": ["listing"]
    },
    "listing": {
      "type": "ListItem",
      "props": { "label": { "$item": "name" } },
      "slots": { "suffix": ["delete", "cancel", "confirm"] }
    },

    "delete": {
      "type": "Button",
      "props": { "label": "Delete", "icon": "delete", "hideLabel": true, "variant": "plain" },
      "visible": { "$item": "armed", "not": true },
      "on": { "press": { "action": "arm", "params": { "item": { "$item": "" } } } }
    },
    "cancel": {
      "type": "Button",
      "props": { "label": "Cancel", "icon": "cancel", "hideLabel": true, "variant": "plain" },
      "visible": { "$item": "armed" },
      "on": { "press": { "action": "setState", "params": { "statePath": { "$item": "armed" }, "value": false } } }
    },
    "confirm": {
      "type": "Button",
      "props": { "label": "Confirm", "icon": "delete-confirm", "hideLabel": true, "variant": "plain" },
      "visible": { "$item": "armed" },
      "on": { "press": { "action": "removeState", "params": { "statePath": "/items", "index": { "$index": true } } } }
    },

    "empty-state": {
      "type": "Text",
      "props": { "text": "No items left.", "muted": true },
      "visible": { "$state": "/items/0", "not": true },
      "children": ["reset"]
    },
    "reset": {
      "type": "Button",
      "props": { "label": "Reset", "variant": "plain" },
      "on": { "press": { "action": "setState", "params": { "statePath": "/items", "value": { "$state": "/listings" } } } }
    }
  }
}
