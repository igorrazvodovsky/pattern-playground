{
  "root": "consequence-ladder-demo",
  "elements": {
    "consequence-ladder-demo": {
      "type": "Stack",
      "props": { "gap": "m" },
      "children": ["actions", "reset", "toasts", "publish-dialog", "transfer-dialog"],
      "watch": {
        "/transferring": { "action": "setState", "params": { "statePath": "/confirmation", "value": { "typed": "", "attempted": false } } }
      }
    },
    "actions": {
      "type": "Grid",
      "props": { "minColumnWidth": "m" },
      "children": ["project", "member", "draft", "published-draft", "ownership", "transferred-ownership"]
    },

    "project": {
      "type": "Card",
      "props": { "title": { "$state": "/project" }, "icon": "project" },
      "visible": { "$state": "/archived", "not": true },
      "children": ["project-text"],
      "slots": { "suffix": ["project-badge"], "actions": ["archive"] }
    },
    "project-badge": { "type": "Badge", "props": { "text": "Project" } },
    "project-text": {
      "type": "Text",
      "props": { "text": "A side project that has gone quiet. Archiving clears it from the workspace; you can restore it whenever." }
    },
    "archive": {
      "type": "Button",
      "props": { "label": "Archive", "icon": "archive", "focusNext": "Remove" },
      "on": {
        "press": [
          { "action": "setState", "params": { "statePath": "/archived", "value": true } },
          {
            "action": "pushState",
            "params": {
              "statePath": "/toasts",
              "value": { "id": "$id", "message": { "$template": "${/project} archived" }, "actionLabel": "Undo", "undo": "/archived" }
            }
          }
        ]
      }
    },

    "member": {
      "type": "Card",
      "props": { "title": { "$state": "/member/name" }, "icon": "person" },
      "visible": { "$state": "/removed", "not": true },
      "children": ["member-text"],
      "slots": { "suffix": ["member-badge"], "actions": ["remove", "cancel-remove", "confirm-remove"] }
    },
    "member-badge": { "type": "Badge", "props": { "text": "Editor" } },
    "member-text": {
      "type": "Text",
      "props": { "text": "Removing a member revokes their access. Re-inviting is a round trip, so the action pauses for a moment's confirmation." }
    },
    "remove": {
      "type": "Button",
      "props": { "label": "Remove", "icon": "remove-person", "focusNext": "Cancel" },
      "visible": { "$state": "/member/armed", "not": true },
      "on": { "press": { "action": "arm", "params": { "item": "/member" } } }
    },
    "cancel-remove": {
      "type": "Button",
      "props": { "label": "Cancel", "icon": "cancel", "hideLabel": true, "variant": "plain", "focusNext": "Remove" },
      "visible": { "$state": "/member/armed" },
      "on": { "press": { "action": "setState", "params": { "statePath": "/member/armed", "value": false } } }
    },
    "confirm-remove": {
      "type": "Button",
      "props": { "label": "Remove", "variant": "danger", "focusNext": "Remove" },
      "visible": { "$state": "/member/armed" },
      "on": {
        "press": [
          { "action": "setState", "params": { "statePath": "/removed", "value": true } },
          { "action": "setState", "params": { "statePath": "/member/armed", "value": false } },
          {
            "action": "pushState",
            "params": {
              "statePath": "/toasts",
              "value": { "id": "$id", "message": { "$template": "${/member/name} removed" }, "actionLabel": "Undo", "undo": "/removed" }
            }
          }
        ]
      }
    },

    "draft": {
      "type": "Card",
      "props": { "title": { "$state": "/draft" }, "icon": "document" },
      "visible": { "$state": "/published", "not": true },
      "children": ["draft-text"],
      "slots": { "suffix": ["draft-badge"], "actions": ["publish"] }
    },
    "draft-badge": { "type": "Badge", "props": { "text": "Draft" } },
    "draft-text": {
      "type": "Text",
      "props": { "text": "Publishing makes this visible to the whole company. A dialog spells out who that reaches before you commit." }
    },
    "publish": {
      "type": "Button",
      "props": { "label": "Publish…", "icon": "publish" },
      "on": { "press": { "action": "setState", "params": { "statePath": "/publishing", "value": true } } }
    },
    "published-draft": {
      "type": "Card",
      "props": { "title": { "$state": "/draft" }, "icon": "document" },
      "visible": { "$state": "/published" },
      "children": ["published-text"],
      "slots": { "suffix": ["published-badge"] }
    },
    "published-badge": { "type": "Badge", "props": { "text": "Public" } },
    "published-text": {
      "type": "Text",
      "props": { "text": { "$template": "Visible to everyone at ${/workspace}." } }
    },

    "ownership": {
      "type": "Card",
      "props": { "title": "Ownership", "icon": "ownership" },
      "visible": { "$state": "/transferred", "not": true },
      "children": ["ownership-text"],
      "slots": { "suffix": ["ownership-badge"], "actions": ["transfer"] }
    },
    "ownership-badge": { "type": "Badge", "props": { "text": "Owned by you" } },
    "ownership-text": {
      "type": "Text",
      "props": { "text": "Handing over ownership is final for you. The dialog asks you to type the workspace name first." }
    },
    "transfer": {
      "type": "Button",
      "props": { "label": "Transfer ownership…", "icon": "transfer" },
      "on": { "press": { "action": "setState", "params": { "statePath": "/transferring", "value": true } } }
    },
    "transferred-ownership": {
      "type": "Card",
      "props": { "title": "Ownership", "icon": "ownership" },
      "visible": { "$state": "/transferred" },
      "children": ["transferred-text"],
      "slots": { "suffix": ["transferred-badge"] }
    },
    "transferred-badge": { "type": "Badge", "props": { "text": { "$template": "Owned by ${/newOwner}" } } },
    "transferred-text": {
      "type": "Text",
      "props": { "text": { "$template": "${/newOwner} controls this workspace now." } }
    },

    "reset": {
      "type": "Button",
      "props": { "label": "Reset", "variant": "plain" },
      "visible": {
        "$or": [{ "$state": "/archived" }, { "$state": "/removed" }, { "$state": "/published" }, { "$state": "/transferred" }]
      },
      "on": {
        "press": [
          { "action": "setState", "params": { "statePath": "/archived", "value": false } },
          { "action": "setState", "params": { "statePath": "/removed", "value": false } },
          { "action": "setState", "params": { "statePath": "/published", "value": false } },
          { "action": "setState", "params": { "statePath": "/transferred", "value": false } },
          { "action": "setState", "params": { "statePath": "/member/armed", "value": false } },
          { "action": "setState", "params": { "statePath": "/confirmation", "value": { "typed": "", "attempted": false } } },
          { "action": "setState", "params": { "statePath": "/toasts", "value": [] } },
          { "action": "setState", "params": { "statePath": "/pressed", "value": null } }
        ]
      }
    },

    "toasts": {
      "type": "Toasts",
      "props": { "toasts": { "$bindState": "/toasts" }, "pressed": { "$bindState": "/pressed" } },
      "on": {
        "action": { "action": "setState", "params": { "statePath": { "$state": "/pressed/undo" }, "value": false } }
      }
    },

    "publish-dialog": {
      "type": "Dialog",
      "props": {
        "title": { "$template": "Publish to everyone at ${/workspace}" },
        "description": {
          "$template": "Everyone at ${/workspace}, ${/workspaceSize} people, will be able to view ${/draft}. You can unpublish later, but anyone may have read or copied it by then."
        },
        "open": { "$bindState": "/publishing" }
      },
      "slots": { "actions": ["confirm-publish", "cancel-publish"] }
    },
    "confirm-publish": {
      "type": "Button",
      "props": { "label": "Publish", "variant": "primary", "initialFocus": true },
      "on": {
        "press": [
          { "action": "setState", "params": { "statePath": "/published", "value": true } },
          { "action": "setState", "params": { "statePath": "/publishing", "value": false } }
        ]
      }
    },
    "cancel-publish": {
      "type": "Button",
      "props": { "label": "Cancel" },
      "on": { "press": { "action": "setState", "params": { "statePath": "/publishing", "value": false } } }
    },

    "transfer-dialog": {
      "type": "Dialog",
      "props": {
        "title": "Transfer ownership",
        "description": {
          "$template": "Ownership of the ${/workspace} workspace moves to ${/newOwner}. You keep editing rights but can no longer manage members, publishing, or deletion, and only the new owner can transfer it back."
        },
        "open": { "$bindState": "/transferring" },
        "alert": true
      },
      "children": ["transfer-confirmation"],
      "slots": { "actions": ["confirm-transfer", "cancel-transfer"] }
    },
    "transfer-confirmation": {
      "type": "Input",
      "props": {
        "label": { "$template": "Type ${/workspace} to confirm" },
        "value": { "$bindState": "/confirmation/typed" },
        "error": {
          "$cond": { "$and": [{ "$state": "/confirmation/attempted" }, { "$state": "/confirmation/typed", "neq": { "$state": "/workspace" } }] },
          "$then": { "$template": "Type ${/workspace} exactly as shown to transfer ownership." },
          "$else": null
        },
        "initialFocus": true
      }
    },
    "confirm-transfer": {
      "type": "Button",
      "props": {
        "label": "Transfer ownership",
        "variant": "danger"
      },
      "on": {
        "press": [
          { "action": "setState", "params": { "statePath": "/confirmation/attempted", "value": true } },
          { "action": "setState", "params": { "statePath": "/transferred", "value": { "$cond": { "$state": "/confirmation/typed", "eq": { "$state": "/workspace" } }, "$then": true, "$else": false } } },
          { "action": "setState", "params": { "statePath": "/transferring", "value": { "$cond": { "$state": "/confirmation/typed", "eq": { "$state": "/workspace" } }, "$then": false, "$else": true } } }
        ]
      }
    },
    "cancel-transfer": {
      "type": "Button",
      "props": { "label": "Cancel" },
      "on": { "press": { "action": "setState", "params": { "statePath": "/transferring", "value": false } } }
    }
  }
}
