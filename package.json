{
  "name": "pattern-playground",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev -w @pattern-plgrnd/patterns",
    "extract-graph": "npx tsx scripts/extract-graph-data.ts",
    "storybook": "npm run storybook -w @pattern-plgrnd/components",
    "build-storybook": "npm run build-storybook -w @pattern-plgrnd/components",
    "build:storybook-index": "npm run build-storybook && mkdir -p apps/patterns/storybook-index && cp packages/components/storybook-static/index.json apps/patterns/storybook-index/index.json",
    "build:storybook-into-site": "npm run build:storybook-index && rm -rf public/storybook && cp -r packages/components/storybook-static public/storybook",
    "build": "npm run build:storybook-into-site && npm run build -w @pattern-plgrnd/patterns",
    "test-storybook": "vitest --project=storybook",
    "test": "node scripts/check-seed-staleness.mjs && eslint .",
    "test styles": "stylelint **/*.css"
  },
  "devDependencies": {
    "@types/node": "^22.16.0",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "culori": "^4.0.2",
    "eslint": "^9.35.0",
    "eslint-plugin-lit": "^2.1.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-storybook": "^10.4.0",
    "globals": "^16.4.0",
    "playwright": "^1.58.2",
    "serve": "^14.2.5",
    "stylelint": "^16.24.0",
    "stylelint-config-standard": "^37.0.0",
    "stylelint-gamut": "^1.3.4",
    "stylelint-selector-bem-pattern": "^4.0.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vite": "^8.1.3",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "storybook": "^10.4.0",
    "@tiptap/react": {
      "react": "^19.1.1",
      "react-dom": "^19.1.1"
    }
  }
}
