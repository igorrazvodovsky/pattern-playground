{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "pattern",
        "umbrella",
        "quality",
        "foundation",
        "component"
      ]
    },
    "activityLevel": {
      "type": "string",
      "enum": [
        "operation",
        "action",
        "activity"
      ]
    },
    "lifecycle": {
      "type": "string"
    },
    "group": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "atomic": {
      "type": "string",
      "enum": [
        "primitive",
        "component",
        "composition",
        "pattern"
      ]
    },
    "mediation": {
      "type": "string",
      "enum": [
        "individual",
        "coordination"
      ]
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "role"
  ]
}