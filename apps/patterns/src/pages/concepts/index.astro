---
// The concept catalogue's index: what a concept is (linking to Jackson's
// concept design), how it relates to patterns, and every entry with its
// purpose. Entries the fixture world instantiates are marked, since those are
// the ones a demo can replay.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { panePath } from '../../lib/pane-path';
import { worldActionsByConcept } from '../../lib/concept';

const concepts = (await getCollection('concepts')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
const grounded = worldActionsByConcept();
---

<Base title="Concepts" corner="concepts">
  <article class="flow" data-pagefind-body data-pagefind-meta="title:Concepts">
    <header>
      <div class="meta">
        <h1>Concepts</h1>
      </div>
    </header>

    <p>
      Concepts are user-facing units of functionality, following{' '}
      <a href="https://essenceofsoftware.com/tutorials/concept-basics/sw-as-concepts/">
        Daniel Jackson's concept design
      </a>
      . Each entry records a concept's purpose, operational principle, state, actions and{' '}
      <a href="https://essenceofsoftware.com/tutorials/design-general/misfits/">misfits</a>.
    </p>

    <p>
      Patterns act on concepts. The concept is what the system does and what the acts mean, and the
      pattern is what the maker should do about it in a situation.
    </p>

    <ul>
      {concepts.map((c) => (
        <li>
          <a href={panePath('concept', c.id)}>{c.data.title}</a>
          <br />
          <span>{c.data.purpose}</span>
        </li>
      ))}
    </ul>
  </article>
</Base>
