---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { Demo } from '../../components/Demo';
import { ComponentRef } from '../../components/ComponentRef';

export async function getStaticPaths() {
  const entries = await getCollection('patterns');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} slug={entry.id}>
  <article class="flow">
    <header>
      <h1>{entry.data.title}</h1>
      {entry.data.description && <p class="description">{entry.data.description}</p>}
      <div class="meta">
        <span class="badge role">{entry.data.role}</span>
        {entry.data.activityLevel && <span class="badge">{entry.data.activityLevel}</span>}
        {entry.data.mediation && <span class="badge">{entry.data.mediation}</span>}
      </div>
    </header>
    <Content components={{ Demo, ComponentRef }} />
  </article>
</Base>
