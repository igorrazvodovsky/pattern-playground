---
// The one rendering of a pattern's article, shared by the full page
// (pages/patterns/[...slug].astro) and the pane partial
// (pages/patterns/[slug]/pane.astro) so the two cannot drift.
import { render, type CollectionEntry } from 'astro:content';
import Demo from './Demo.astro';
import Diagram from './Diagram.astro';
import { ComponentRef } from './ComponentRef';
import Consequences from './Consequences.astro';
import Situation from './Situation.astro';
import ArticleShell from './ArticleShell.astro';
import EpistemicStatus from './EpistemicStatus.astro';
import ActsOn from './ActsOn.astro';
import SequenceAppearances from './SequenceAppearances.astro';
import RelatedPatterns from './RelatedPatterns.astro';
import Residue from './Residue.astro';

interface Props {
  entry: CollectionEntry<'patterns'>;
  // False for the pane partial (see ArticleShell).
  pagefind?: boolean;
}

const { entry, pagefind = true } = Astro.props;
const { Content } = await render(entry);
---
{/* Badges once shown beside the title, kept for reference:
    <span class="badge role">{entry.data.role}</span>
    {entry.data.activityLevel && <span class="badge">{entry.data.activityLevel}</span>}
    {entry.data.mediation && <span class="badge">{entry.data.mediation}</span>} */}
<ArticleShell title={entry.data.title} dates={entry} pagefind={pagefind}>
  <Fragment slot="meta">
    <EpistemicStatus entry={entry} />
    <ActsOn entry={entry} />
  </Fragment>
  {/* Consequences, SequenceAppearances, RelatedPatterns and Residue are not
      authored: integrations/remark-consequences.ts injects them into the body
      in the contract's page order, so the whole page composes in one place. */}
  <Content components={{ Demo, ComponentRef, Diagram, Consequences, Situation, SequenceAppearances, RelatedPatterns, Residue }} />
</ArticleShell>
