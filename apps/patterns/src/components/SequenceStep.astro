---
import Label from './Label.astro';
import { patternRef, type PatternTitles, type Step } from '../lib/sequence';

interface Props {
  step: Step;
  titles: PatternTitles;
}

const { step, titles } = Astro.props;

const rule = step.rule ? patternRef(titles, step.rule) : undefined;

---

<p>
  <strong>{step.step}</strong>
  {rule && (
    <Fragment>
      {' — '}
      {rule.href ? <a href={rule.href}>{rule.label}</a> : rule.label}
      {step.aspect && <em>, {step.aspect}</em>}
    </Fragment>
  )}
  {step.optional && <Fragment>{' · '}<em>optional</em></Fragment>}
</p>

{step.gloss && <p><Label text={step.gloss} /></p>}
