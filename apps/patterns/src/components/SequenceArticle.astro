---
// `presupposes` precedes the body: it says whether the sequence applies at all,
// which is needed before the walk rather than after it. A sub-sequence's
// `initiating` takes the same fold one scale down (SequenceWalk.astro).
import { render, type CollectionEntry } from 'astro:content';
import Demo from './Demo.astro';
import Diagram from './Diagram.astro';
import { ComponentRef } from './ComponentRef';
import PatternDates from './PatternDates.astro';
import SequenceWalk from './SequenceWalk.astro';
import Label from './Label.astro';

interface Props {
  entry: CollectionEntry<'sequences'>;
  // The pane fragment (sequences/[id]/pane.astro) renders the same article;
  // dropping the pagefind attributes keeps it out of the search index.
  pagefind?: boolean;
}

const { entry, pagefind = true } = Astro.props;
const { Content } = await render(entry);
---
<article
  class="flow"
  data-pagefind-body={pagefind ? '' : undefined}
  data-pagefind-meta={pagefind ? `title:${entry.data.title}` : undefined}
>
  <header>
    <div class="meta">
      <h1>{entry.data.title}</h1>
      <PatternDates entry={entry} />
    </div>
  </header>
  <pp-toc heading="On this page" data-pagefind-ignore></pp-toc>
  <details class="sequence-initiating muted">
    <summary>Prerequisites</summary>
    <p><Label text={entry.data.presupposes} /></p>
  </details>
  <Content components={{ Demo, ComponentRef, Diagram }} />
  <SequenceWalk entry={entry} />
</article>
