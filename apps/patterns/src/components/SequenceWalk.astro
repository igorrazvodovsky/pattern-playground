---
// Renders the frontmatter layer, which is authoritative for order and membership;
// the body narrates the same sequence in prose. The markup follows
// docs/specs/sequences.md §Rendering: heading ids are sub-sequence ids, and a
// cluster nests as a <ul> inside its one numbered <li>.
import { getCollection, type CollectionEntry } from 'astro:content';
import Label from './Label.astro';
import SequenceStep from './SequenceStep.astro';
import { isChoice, isCluster, positionAnchor } from '../lib/sequence';

interface Props {
  entry: CollectionEntry<'sequences'>;
}

const { entry } = Astro.props;
const subSequences = entry.data['sub-sequences'];

const patternTitles = new Map((await getCollection('patterns')).map((p) => [p.id, p.data.title]));
---

<section class="flow sequence">
  {subSequences.map((sub) => (
    <section class="flow">
      <h2 id={sub.id}>{sub.title}</h2>

      {sub.initiating && (
        <p class="sequence-initiating muted">
          <em>Applies when:</em> <Label text={sub.initiating} />
        </p>
      )}

      <ol class="sequence__steps">
        {sub.steps.map((position, i) => (
          <li class="flow" id={positionAnchor(sub.id, i)}>
            {isCluster(position) ? (
              <Fragment>
                <p>
                  <strong>{position.cluster}</strong>
                </p>
                {position.gloss && (
                  <p>
                    <Label text={position.gloss} />
                  </p>
                )}
                <p class="sequence__lead-in">
                  <em>In any order:</em>
                </p>
                <ul class="sequence__alternatives">
                  {position.steps.map((step) => (
                    <li class="flow">
                      <SequenceStep step={step} titles={patternTitles} />
                    </li>
                  ))}
                </ul>
              </Fragment>
            ) : isChoice(position) ? (
              <Fragment>
                <p>
                  <strong>{position.choice}</strong>
                </p>
                {position.gloss && (
                  <p>
                    <Label text={position.gloss} />
                  </p>
                )}
                <p class="sequence__lead-in">
                  <em>One or more of:</em>
                </p>
                <ul class="sequence__alternatives">
                  {position.alternatives.map((step) => (
                    <li class="flow">
                      <SequenceStep step={step} titles={patternTitles} />
                    </li>
                  ))}
                </ul>
              </Fragment>
            ) : (
              <SequenceStep step={position} titles={patternTitles} />
            )}
          </li>
        ))}
      </ol>

      {sub.resulting && (
        <p class="muted">
          <em>Leaves:</em> <Label text={sub.resulting} />
        </p>
      )}
    </section>
  ))}
</section>
