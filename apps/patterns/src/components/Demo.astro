---
// The resize handle is a drag strip pinned to the content's trailing edge (its
// edge sits at --demo-w); lib/demo-expander.ts turns a drag into --demo-w on the
// pane. The widen button lives in the footer, not over the demo: a corner button
// collides with a demo's own chrome (a canvas's tool panels), and a demo
// captures pointer events on its own root. The frame is a region so that a
// demo's own headings sit inside a boundary assistive technology announces.
import { libraryLabels, type Library } from '../lib/demo-libraries';

interface Props {
  // Registry name of a client-mounted demo (lib/demo-registry.ts). When given,
  // the frame renders a <div data-demo> mount point instead of slot children;
  // mountDemos() resolves the name and mounts the React component client-side.
  name?: string;
  // Props forwarded to the mounted component, serialised as JSON in a data
  // attribute and parsed by the registry.
  props?: Record<string, unknown>;
  // A switchable demo: the slug of a spec in packages/components/src/demos/specs/
  // (<slug>.json, <slug>.ts, or both).
  // The frame renders a <div data-demo-spec> mount point and a footer control
  // for switching the component library the spec renders through.
  spec?: string;
  // The libraries the spec can render through (catalog/registries/). With one
  // entry the frame renders no switch. Defaults to every library.
  registries?: Library[];
  // The library the spec renders through first; the first of `registries` by default.
  registry?: Library;
  label?: string;
  surface?: 'gray' | 'white' | 'border';
  // Both features drive one width axis (--demo-w) shared through lib/demo-expander.ts:
  // `resizable` renders a drag handle for continuous control; `expandable` renders
  // a button that snaps to preset widths (reading / wide / full) on the same axis.
  // Either can appear alone; together the button is the preset for the drag.
  expandable?: boolean;
  resizable?: boolean;
  // Height the demo is clipped to before the actor expands it (lib/demo-height.ts).
  // Any CSS length; false renders the demo at its natural height. Defaults to
  // --demo-max-h in app.css.
  maxHeight?: string | false;
}

const {
  name,
  props,
  spec,
  label,
  surface = 'border',
  expandable,
  resizable,
  maxHeight,
  registries = Object.keys(libraryLabels) as Library[],
  registry: requestedRegistry,
} = Astro.props;
// A starting library the switch does not offer would strand the demo there.
const registry =
  requestedRegistry && registries.includes(requestedRegistry) ? requestedRegistry : registries[0];

// Labels are captions, too long for a region's name, so they describe it instead.
const labelId = label ? `demo-label-${crypto.randomUUID().slice(0, 8)}` : undefined;

const surfaceClass = {
  gray: 'layer gray',
  white: 'layer border',
  border: 'border',
} as const;
---

<section class="demo-block" aria-label="Demo" aria-describedby={labelId}>
  <div
    class={`demo-block__content ${surfaceClass[surface]}`}
    data-resizable={resizable || undefined}
    data-demo-revealed={maxHeight === false || undefined}
    style={typeof maxHeight === 'string' ? { '--demo-max-h': maxHeight } : undefined}
  >
    <div class="demo-block__viewport" data-demo-viewport tabindex="-1">
      {spec ? (
        <div data-demo-spec={spec} data-demo-registry={registry}></div>
      ) : name ? (
        <div data-demo={name} data-demo-props={props ? JSON.stringify(props) : undefined}></div>
      ) : (
        <slot />
      )}
    </div>
    <button type="button" class="button demo-block__reveal" data-demo-reveal>
      Expand
    </button>
    {resizable && (
      <div
        class="demo-resize-handle"
        data-demo-resize
        role="separator"
        aria-orientation="vertical"
        aria-label="Drag to resize this demo"
        title="Drag to resize this demo"
        tabindex="0"
      ></div>
    )}
  </div>
  {(label || expandable || spec) && (
    <div class="demo-block__footer">
      {label && (
        <span class="demo-block__label" id={labelId}>
          {label}
        </span>
      )}
      {spec && registries.length > 1 && (
        <div class="demo-registry-switch" role="group" aria-label="Component library">
          {registries.map((r) => (
            <button
              type="button"
              data-demo-registry-option={r}
              aria-pressed={r === registry ? 'true' : 'false'}
            >
              {libraryLabels[r]}
            </button>
          ))}
        </div>
      )}
      {expandable && (
        <button
          type="button"
          class="demo-expand"
          data-demo-expand
          aria-label="Widen this demo"
          title="Widen this demo"
        >
          <iconify-icon icon="ik:arrow-left-right" aria-hidden="true"></iconify-icon>
        </button>
      )}
    </div>
  )}
</section>
