---
/**
 * Renders typed edges for the current pattern as a "Related patterns" section.
 * Reads from pattern-graph.json; renders declared edges only, in declaration order.
 *
 * Outgoing directed edges are shown with the canonical label. Incoming directed
 * edges are shown as their computed inverse ("preceded by", "enabled by", etc.).
 * Symmetric edges (complements, tangential, alternative, related) are shown once
 * per page in the direction they are declared (either outgoing or incoming).
 * Beside each connection sits this page's note or edge sentence; where it has
 * none, the far page's sentence is quoted, in quotation marks, so a sentence
 * written for another page's reader is read as that page's words.
 */

import graphData from '../data/pattern-graph.json';
import Label from './Label.astro';
import SequenceAppearances from './SequenceAppearances.astro';
import Situation from './Situation.astro';
import { sequenceAppearances } from '../lib/sequence';

interface Props {
  slug: string;
  /** `situation.resulting` as prose: the connections passage. Its presence
   * selects the narrated render. */
  resulting?: string;
  /** False hides the typed index under the passage (`showRelated: false`);
   * the passage itself still renders. */
  index?: boolean;
}

const { slug, resulting, index = true } = Astro.props;

interface Edge {
  source: string;
  target: string;
  type: string;
  label?: string;
  incomingNote?: string;
  /** Derived, never authored: the sentence of the source's situation prose
   * that links the target, or a resulting clause with `sets-up` — prose for
   * judgement, never matched on (relationship-vocabulary.md §Situations). */
  situation?: string;
  glossFrom?: string;
  /** The other endpoint's sentence, when both pages link each other. */
  farSituation?: string;
}

/** A line's text and whether it is quoted from the far page. */
interface Gloss {
  text: string;
  far: boolean;
}

interface PatternNode {
  id: string;
  title: string;
  path: string;
  role?: string;
}

const nodes: Record<string, PatternNode> = {};
for (const n of graphData.nodes as PatternNode[]) {
  nodes[n.id] = n;
}

// quality pages carry no pattern list. A quality is a diagnostic
// lens, not a catalogue of its instances — the bridge to patterns lives on the
// pattern side via `enacts` and is explored through the graph, never rendered
// here. See docs/language/relationship-vocabulary.md.
const isQuality = nodes[slug]?.role === 'quality';

const edges = graphData.edges as Edge[];

// Symmetric edge types: shown once per pair regardless of stored direction.
const SYMMETRIC = new Set(['complements', 'tangential', 'alternative', 'related']);

// Human-readable section labels for outgoing and incoming edges.
const OUTGOING_LABELS: Record<string, string> = {
  precedes: 'Precedes',
  enables: 'Enables',
  instantiates: 'Instantiates',
  enacts: 'Enacts',
  surveys: 'Surveys',
  hosts: 'Hosts',
  serves: 'Serves',
  complements: 'Complements',
  tangential: 'Tangential to',
  alternative: 'Alternatives',
  related: 'Related to',
};

const INCOMING_LABELS: Record<string, string> = {
  precedes: 'Preceded by',
  enables: 'Enabled by',
  instantiates: 'Instantiated by',
  enacts: 'Enacted by',
  surveys: 'Surveyed by',
  hosts: 'Hosted by',
  serves: 'Served by',
};

// Collect outgoing and incoming edges for this pattern, grouped by peer: a
// symmetric pair may be authored from both endpoints as two edges.
interface GroupEntry {
  node: PatternNode;
  label?: string;
  far?: boolean;
}
const outgoing: Record<string, Map<string, Edge[]>> = {};
const incoming: Record<string, Map<string, Edge[]>> = {};

const add = (
  groups: Record<string, Map<string, Edge[]>>,
  type: string,
  peerId: string,
  edge: Edge,
) => {
  const byPeer = (groups[type] ??= new Map());
  byPeer.set(peerId, [...(byPeer.get(peerId) ?? []), edge]);
};

for (const edge of edges) {
  const isOut = edge.source === slug;
  const isIn = edge.target === slug;
  if (!isOut && !isIn) continue;

  const peerId = isOut ? edge.target : edge.source;
  if (!nodes[peerId]) continue;

  // Symmetric edges read the same from either end, so they list as outgoing.
  if (SYMMETRIC.has(edge.type) || isOut) add(outgoing, edge.type, peerId, edge);
  else if (INCOMING_LABELS[edge.type]) add(incoming, edge.type, peerId, edge);
}

// Which page's prose a derived sentence came from; a `sets-up` clause carries
// no `glossFrom` and is the source's.
const sentenceEnd = (edge: Edge) => edge.glossFrom?.split(':')[0] ?? 'source';

// A sentence lifted from the opening's first line starts lowercase, after the
// renderer's ellipsis; standing alone it takes a capital. A `sets-up` clause
// is a fragment, like a note, and keeps its case.
const capitalise = (text: string) =>
  text.replace(/^(\[?)([a-z])/, (_, bracket, c) => bracket + c.toUpperCase());

// The near side wins, so the link reads in this page's voice: this page's
// note, then its own sentence, then the far page's sentence (quoted), then
// its note. A note is written to read from both pages and is never quoted.
function pickLabel(pair: Edge[]): Gloss | undefined {
  const near: (string | undefined)[] = [];
  const farSentence: (string | undefined)[] = [];
  const farNote: (string | undefined)[] = [];
  for (const edge of pair) {
    const nearEnd = edge.source === slug ? 'source' : 'target';
    near.push(nearEnd === 'source' ? edge.label : edge.incomingNote);
    farNote.push(nearEnd === 'source' ? edge.incomingNote : edge.label);
    const own = edge.situation && edge.glossFrom ? capitalise(edge.situation) : edge.situation;
    const other = edge.farSituation && capitalise(edge.farSituation);
    if (sentenceEnd(edge) === nearEnd) {
      near.push(own);
      farSentence.push(other);
    } else {
      near.push(other);
      farSentence.push(own);
    }
  }
  const nearText = near.find((l) => l !== undefined);
  if (nearText !== undefined) return { text: nearText, far: false };
  const quoted = farSentence.find((l) => l !== undefined);
  if (quoted !== undefined) return { text: quoted, far: true };
  const note = farNote.find((l) => l !== undefined);
  return note === undefined ? undefined : { text: note, far: false };
}

// A sentence quoted on this page may link this page, where the link goes
// nowhere, and the neighbour it sits beside, whose title is already the link.
const unlink = (text: string, ids: string[]) =>
  ids.reduce(
    (t, id) =>
      t.replace(new RegExp(String.raw`\[([^\]]+)\]\(/patterns/${id}(?:[/#?][^)]*)?\)`, 'g'), '$1'),
    text,
  );

const entriesOf = (byPeer: Map<string, Edge[]>): GroupEntry[] =>
  [...byPeer].map(([peerId, pair]) => {
    const gloss = pickLabel(pair);
    return { node: nodes[peerId], label: gloss && unlink(gloss.text, [slug]), far: gloss?.far };
  });

// Build ordered sections: directed outgoing, then symmetric, then incoming.
const DIRECTED_OUT_ORDER = [
  'precedes',
  'enables',
  'instantiates',
  'hosts',
  'serves',
  'enacts',
  'surveys',
];
const SYMMETRIC_ORDER = ['complements', 'tangential', 'alternative', 'related'];
const DIRECTED_IN_ORDER = ['precedes', 'enables', 'instantiates', 'hosts', 'serves', 'enacts'];

type Section = { heading: string; entries: GroupEntry[] };
const sections: Section[] = [];

for (const type of DIRECTED_OUT_ORDER) {
  if (outgoing[type]?.size) {
    sections.push({ heading: OUTGOING_LABELS[type], entries: entriesOf(outgoing[type]) });
  }
}
for (const type of SYMMETRIC_ORDER) {
  if (outgoing[type]?.size) {
    sections.push({ heading: OUTGOING_LABELS[type], entries: entriesOf(outgoing[type]) });
  }
}
for (const type of DIRECTED_IN_ORDER) {
  if (incoming[type]?.size) {
    sections.push({ heading: INCOMING_LABELS[type], entries: entriesOf(incoming[type]) });
  }
}

// One sentence often links several neighbours, or one neighbour under two
// types. In the folded index, entries sharing a sentence share a line; in
// either render, a sentence already shown is not repeated.
type Line = { nodes: PatternNode[]; label?: string; far?: boolean; fresh: boolean };
const shown = new Set<string>();
const indexLines = sections.map(({ heading, entries }) => {
  const lines: Line[] = [];
  for (const { node, label, far } of entries) {
    const line = label && lines.find((l) => l.label === label);
    if (line) line.nodes.push(node);
    else lines.push({ nodes: [node], label, far, fresh: !label || !shown.has(label) });
  }
  for (const { label } of entries) if (label) shown.add(label);
  return { heading, lines };
});
shown.clear();
const listSections = sections.map(({ heading, entries }) => ({
  heading,
  entries: entries.map(({ node, label, far }) => {
    const fresh = label && !shown.has(label);
    if (label) shown.add(label);
    return { node, label: fresh ? label : undefined, far };
  }),
}));

// A far page's sentence is shown as its words, in quotation marks.
const quote = (text: string, far?: boolean) => (far ? `“${text}”` : text);

// The connections passage is the resulting situation (`situation.resulting`
// as prose, passed in by integrations/remark-consequences.ts). When it is
// present the index below it is folded away by default, one group per type
// and one line per connection with its sentence: the prose is the reading
// surface and the index is the record.
const narrated = typeof resulting === 'string';
// The passage is authored prose and renders on any page that has one; the
// quality rule and `showRelated` govern the index only.
const hasRelated = narrated || (!isQuality && sections.length > 0);
const showIndex = index && !isQuality;
// On a narrated page the sequence appearances fold into the same index.
const hasAppearances = narrated && ((await sequenceAppearances()).get(slug)?.length ?? 0) > 0;

// Titles after the first on a shared line read mid-sentence ("Command menu,
// searching"), so drop the leading capital unless the title opens with an acronym.
const inline = (title: string) =>
  /^[A-Z][A-Z]/.test(title) ? title : title.charAt(0).toLowerCase() + title.slice(1);
---

{hasRelated && narrated && (
  <section class="connections flow" aria-label="Connections">
    <h2 id="connections" class="section-mark">
      Continuation
    </h2>
    <div class="connections__narrated flow">
      <Situation text={resulting} end="resulting" />
    </div>
    {(hasAppearances || (showIndex && sections.length > 0)) && (
      <details class="connections__formal">
        <summary>All connections</summary>
        {showIndex && sections.length > 0 && (
          <dl class="description-list description-list--stacked connections__index">
            {indexLines.map(({ heading, lines }) => (
              <>
                <dt>{heading}</dt>
                {lines.map(({ nodes: peers, label, far, fresh }) => (
                  <dd>
                    {peers.map((node, i) => (
                      <>
                        {i > 0 && ', '}
                        <a href={node.path}>{i > 0 ? inline(node.title) : node.title}</a>
                      </>
                    ))}
                    {label && fresh && (
                      <>
                        {' '}
                        —{' '}
                        <span class="connections__sentence">
                          <Label
                            text={quote(
                              unlink(
                                label,
                                peers.map((n) => n.id),
                              ),
                              far,
                            )}
                          />
                        </span>
                      </>
                    )}
                  </dd>
                ))}
              </>
            ))}
          </dl>
        )}
        {hasAppearances && <SequenceAppearances slug={slug} compact />}
      </details>
    )}
  </section>
)}

{hasRelated && !narrated && (
  <section class="flow" aria-label="Related patterns">
    <h2>Related patterns</h2>
    {listSections.map(({ heading, entries }) => (
      <div class="flow">
        <h3>{heading}</h3>
        <ul>
          {entries.map(({ node, label, far }) => (
            <li>
              <a href={node.path}>{node.title}</a>
              {label && (
                <>
                  {' '}
                  — <Label text={quote(unlink(label, [node.id]), far)} />
                </>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
)}
