---
/**
 * Renders a pattern's resulting context — `situation.resulting` from
 * frontmatter — as the page's "Consequences" section. Like Related patterns,
 * the section is rendered from frontmatter and never authored in the body:
 * the clauses are the judgement's one authorable home, and this is their
 * reader-facing render (relationship-vocabulary.md §Situations). Advice and
 * field observation that a prose Consequences section used to carry live in
 * body sections instead.
 *
 * This is the fallback for pages not yet shaped, whose `situation.resulting`
 * is still a clause list; on a shaped page the resulting situation is prose
 * and renders as the connections passage instead (Situation.astro inside
 * RelatedPatterns.astro). Placement is the remark plugin's job
 * (integrations/remark-consequences.ts): it injects this component into the
 * MDX body before Resources & references, passing the clauses as `resulting`.
 *
 * `situation.initiating` does not render on such a page — the lead narrates
 * it. A clause with `sets-up` also shows as the note on its derived `precedes`
 * edge below; that is the same judgement rendered for a different job
 * (statement here, link context there), not a second home.
 */
import Label from './Label.astro';

type Clause = string | { clause: string; 'sets-up'?: string[] };

interface Props {
  resulting?: Clause[];
}

const { resulting = [] } = Astro.props;
const clauses = resulting.map((c) => (typeof c === 'string' ? c : c.clause));
---

{clauses.length > 0 && (
  <section class="flow" aria-label="Consequences">
    <h2>Consequences</h2>
    <ul>
      {clauses.map((clause) => (
        <li><Label text={clause} /></li>
      ))}
    </ul>
  </section>
)}
