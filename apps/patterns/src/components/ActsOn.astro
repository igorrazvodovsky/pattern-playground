---
// Renders a pattern's `acts_on`: the concepts this pattern is a move on. It
// sits with the pattern's connections: one group of the folded "All
// connections" index on a page with a connections passage, a list in the
// "Related patterns" section otherwise. RelatedPatterns resolves the refs
// (lib/concept.ts `actsOnRefs`) and passes them in.
import Label from './Label.astro';
import type { TitledActsOnRef } from '../lib/concept';
import { panePath } from '../lib/pane-path';

interface Props {
  refs: TitledActsOnRef[];
  /** Render as one group of the folded "All connections" index. */
  compact?: boolean;
}

const { refs, compact = false } = Astro.props;
---

{refs.length > 0 && compact && (
  <dl class="description-list description-list--stacked connections__index" data-pagefind-ignore>
    <dt>Acts on</dt>
    {refs.map((ref) => (
      <dd>
        <a href={panePath('concept', ref.concept)}>{ref.title}</a>
        {ref.note && (
          <>
            {' '}
            — <Label text={ref.note} />
          </>
        )}
      </dd>
    ))}
  </dl>
)}

{refs.length > 0 && !compact && (
  <div class="flow" data-pagefind-ignore>
    <h3>Acts on</h3>
    <ul>
      {refs.map((ref) => (
        <li>
          <a href={panePath('concept', ref.concept)}>{ref.title}</a>
          {ref.note && (
            <>
              {' '}
              — <Label text={ref.note} />
            </>
          )}
        </li>
      ))}
    </ul>
  </div>
)}
