---
import { getCollection, type CollectionEntry } from 'astro:content';
import ClientRouter from 'astro/components/ClientRouter.astro';
import '../styles/lib.css';
import '../styles/fonts.css';
import '../styles/app.css';
import '../styles/stack.css';
import '../styles/link-preview.css';
import '../styles/sequence.css';
import { Nav } from '../components/Nav';
import { StackManager } from '../components/StackManager';

interface Props {
  title: string;
  slug?: string;
  // Pane 0's canonical path, when the page hosting the stack is not a pattern;
  // the store rebuilds the stack URL from it (lib/stack-store.ts).
  panePath?: string;
  // What pane 0 is, for its region label.
  paneKind?: string;
}
const { title, slug, panePath, paneKind = 'Pattern' } = Astro.props;
const storybookUrl = import.meta.env.PUBLIC_STORYBOOK_URL ?? 'http://localhost:6006';

type NavLeaf = { label: string; href: string };
type NavBranch = { label: string; children: NavTreeNode[] };
type NavTreeNode = NavLeaf | NavBranch;
type NavGroup = NavBranch;

// The sidebar reads `role` and, for a few families, `group`. Foundations and
// qualities are lifted into their own groups; everything else is one
// alphabetical list, except the families named in BRANCH_GROUPS, which nest
// under one branch each in it. The other facets — activityLevel, lifecycle,
// domain, and the other `group` values — are lenses the graph and the
// sequences project over, not navigation structure. An Activity-Theory
// grouping used to be offered here as a switchable projection; it was removed
// because it was not carrying navigation, and because a switcher sitting at the
// root of the sidebar implied it reordered everything, not just the patterns.
function roleGroupOf(entry: CollectionEntry<'patterns'>): 'foundations' | 'qualities' | null {
  if (entry.data.role === 'foundation') return 'foundations';
  if (entry.data.role === 'quality') return 'qualities';
  return null;
}

const patterns = (await getCollection('patterns')) as CollectionEntry<'patterns'>[];

function leavesWhere(test: (p: CollectionEntry<'patterns'>) => boolean): NavLeaf[] {
  return patterns
    .filter(test)
    .map((p): NavLeaf => ({ label: p.data.title, href: `/patterns/${p.id}` }))
    .sort((a, b) => a.label.localeCompare(b.label));
}

// Roles read as their own kind of entry, so they stay above the alphabetical
// list rather than dissolving into it.
const sharedGroups: NavGroup[] = (
  [
    { label: 'Foundations', children: leavesWhere((p) => roleGroupOf(p) === 'foundations') },
    { label: 'Qualities', children: leavesWhere((p) => roleGroupOf(p) === 'qualities') },
  ] satisfies NavGroup[]
).filter((g) => g.children.length > 0);

// Families that nest under their own branch, keyed by the first segment of
// `group`. A second segment (`conversation/sequence-management`) becomes a
// sub-branch. A family's collection page opens its branch as the overview.
const BRANCH_GROUPS: Record<string, string> = {
  navigation: 'Navigation',
  conversation: 'Conversational primitives',
};

function groupPath(p: CollectionEntry<'patterns'>): string[] {
  return roleGroupOf(p) === null && p.data.group ? p.data.group.split('/') : [];
}

const inBranch = (p: CollectionEntry<'patterns'>) => groupPath(p)[0] in BRANCH_GROUPS;

const sentenceCase = (slug: string) =>
  slug.charAt(0).toUpperCase() + slug.slice(1).replaceAll('-', ' ');

const byLabel = (a: NavTreeNode, b: NavTreeNode) => a.label.localeCompare(b.label);

function branchFor(key: string): NavBranch {
  const members = patterns.filter((p) => groupPath(p)[0] === key);
  const overview = leavesWhere((p) => members.includes(p) && p.data.role === 'collection')
    .map((leaf): NavLeaf => ({ ...leaf, label: 'Overview' }));
  const subgroups = [...new Set(members.map((p) => groupPath(p)[1]).filter(Boolean))];
  const rest: NavTreeNode[] = [
    ...leavesWhere((p) => members.includes(p) && p.data.role !== 'collection' && !groupPath(p)[1]),
    ...subgroups.map((sub): NavBranch => ({
      label: sentenceCase(sub),
      children: leavesWhere((p) => members.includes(p) && groupPath(p)[1] === sub),
    })),
  ].sort(byLabel);
  return { label: BRANCH_GROUPS[key], children: [...overview, ...rest] };
}

const patternsGroup: NavGroup = {
  label: 'Patterns',
  children: [
    ...leavesWhere((p) => roleGroupOf(p) === null && !inBranch(p)),
    ...Object.keys(BRANCH_GROUPS).map(branchFor).filter((b) => b.children.length > 0),
  ].sort(byLabel),
};

// A sequence is an authored walk over the patterns rather than another way of
// arranging them, so sequences get their own group above the list.
const sequencesGroup: NavGroup = {
  label: 'Sequences',
  children: (await getCollection('sequences'))
    .sort((a, b) =>
      a.data.order - b.data.order || a.data.title.localeCompare(b.data.title))
    .map((s): NavLeaf => ({ label: s.data.title, href: `/sequences/${s.id}` })),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <!-- Locks the cascade layer order before any other CSS can — in prod,
         Astro sometimes inlines a route-only stylesheet (e.g. the home page's
         pattern-graph.css) ahead of the main bundle, unwrapped from "lib",
         which would fix "components" before "lib" and invert precedence.
         is:inline keeps this tag first. Must match the statement in lib.css. -->
    <style is:inline>@layer lib, reset, theme, global, layout, components, utilities, states;</style>
    <meta name="color-scheme" content="light dark" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Pattern Playground</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter />
    <link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
    <script src="/pagefind/pagefind-component-ui.js" type="module" is:inline></script>
    <style is:global>
      html, body { height: 100%; margin: 0; }
    </style>
  </head>
  <body>
    <div class="shell" data-slot="shell">
      <Nav client:load transition:persist="app-nav" shared={sharedGroups} patterns={patternsGroup} sequences={sequencesGroup} storybookUrl={storybookUrl} />
      <main class="shell__main" data-slot="shell-main">
        {slug ? (
          <div class="stack" style="--pane-n: 1">
            <section
              class="pane pane--active"
              data-pane-index="0"
              style="--pane-i: 0"
              role="region"
              aria-label={`${paneKind}: ${title}`}
              aria-current="true"
            >
              <button class="pane-spine" aria-label={`Scroll ${title} into view`}>
                <span aria-hidden="true">{title}</span>
              </button>
              <div class="pane-body">
                <slot />
              </div>
            </section>
            <StackManager client:load slug={slug} title={title} path={panePath} />
          </div>
        ) : (
          <div class="content-inset">
            <slot />
          </div>
        )}
      </main>
    </div>
    <!-- Search. We drive the modal's open() method ourselves rather than using
         <pagefind-modal-trigger>: the bundled trigger's coordination with the
         modal is established once at script load and goes stale across
         ClientRouter / View Transitions swaps (the recreated trigger opens a
         detached modal). The modal itself — engine, UI, open() — survives swaps,
         so a document-level hotkey (the document persists across swaps) and the
         sidebar button both just call open() on the current modal. -->
    <pagefind-modal reset-on-close></pagefind-modal>
    <script is:inline>
      if (!window.__pagefindHotkey) {
        window.__pagefindHotkey = true;
        document.addEventListener('keydown', (e) => {
          if ((e.metaKey || e.ctrlKey) && !e.altKey && e.key.toLowerCase() === 'k') {
            const modal = document.querySelector('pagefind-modal');
            if (modal && typeof modal.open === 'function') {
              e.preventDefault();
              modal.open();
            }
          }
        });
      }
    </script>
    <script>
      import '@components/register-all.ts';
      import '../lib/link-preview.ts';
      import '../lib/demo-expander.ts';
      import '../lib/pattern-dates.ts';
      import { mountDemos } from '../lib/demo-registry.ts';
      // Mount pane-0 demos now, and again after every ClientRouter swap
      // (astro:page-load also fires on initial load; mounting is idempotent).
      mountDemos(document);
      document.addEventListener('astro:page-load', () => mountDemos(document));
    </script>
  </body>
</html>
